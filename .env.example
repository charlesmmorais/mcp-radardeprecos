# Nenhuma variável é obrigatória: todas as fontes são públicas e todos os
# valores abaixo são os padrões. Descomente só o que quiser alterar.

# --- Transporte ---
# RADARDEPRECOS_TRANSPORT=stdio            # stdio | sse | streamable-http
# RADARDEPRECOS_RATE_LIMIT_PER_MINUTE=60   # por origem, só em HTTP

# --- Chamadas às fontes ---
# RADARDEPRECOS_HTTP_TIMEOUT=30
# RADARDEPRECOS_HTTP_MAX_RETRIES=4
# RADARDEPRECOS_TOOL_BUDGET_SECONDS=120          # 0 desativa
# RADARDEPRECOS_LOG_LEVEL=INFO

# --- Endereços das fontes (ex.: apontar para homologação) ---
# PNCP_CONSULTA_BASE_URL=https://pncp.gov.br/api/consulta
# PNCP_PNCP_BASE_URL=https://pncp.gov.br/api/pncp
# PNCP_SEARCH_BASE_URL=https://pncp.gov.br/api/search
# COMPRAS_DADOSABERTOS_BASE_URL=https://dadosabertos.compras.gov.br

# --- Arquivos e dados pessoais ---
# Em HTTP, `caminho_saida` é recusado: o disco é o do servidor, não o do
# usuário. Ligue só se o servidor HTTP roda na sua própria máquina.
# RADARDEPRECOS_PERMITIR_CAMINHO_SAIDA=1
# Desliga o mascaramento de CPF de fornecedor pessoa física.
# RADARDEPRECOS_INCLUIR_CPF_COMPLETO=1

# --- Microsoft Entra ID (opcional, só em HTTP) ---
# Sem tenant e client definidos, o servidor não exige autenticação.
# Ver docs/INTEGRACAO_M365_COPILOT.md.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_REQUIRED_SCOPE=
